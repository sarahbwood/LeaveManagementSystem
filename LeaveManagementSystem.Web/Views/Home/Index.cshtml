@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">

    <div class="quick-links container my-5 py-5">
        <div class="row row-cols-1 row-cols-md-3 mb-3 text-center">
            <div class="col">
                <div class="card mb-4 rounded-3 shadow-sm">
                    <div class="card-header py-3 text-bg-success border-success">
                    </div>
                    
                    <div class="card-body">
                        <h1 class="card-title">
                            Apply for Leave
                        </h1>
                       
                        <button type="button"
                                class="w-100 btn btn-lg btn-outline-success">
                            Apply for Leave
                        </button>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card mb-4 rounded-3 shadow-sm">
                    <div class="card-header py-3 text-bg-info border-success">
                    </div>
                   
                    <div class="card-body">
                        <h1 class="card-title">
                            Check Leave Status
                        </h1>
                        
                        <button type="button" class="w-100 btn btn-lg btn-outline-info">
                            Check Leave Status
                        </button>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card mb-4 rounded-3 shadow-sm border-dark">
                    <div class="card-header py-3 text-bg-danger border-dark">
                        
                    </div>
                    <div class="card-body">
                        <h1 class="card-title">
                            Review Leave Requests
                        </h1>
                        
                        <button type="button" class="w-100 btn btn-lg btn-outline-danger">
                            Review Leave Requests
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

